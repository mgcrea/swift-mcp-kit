{
  "sourceLanguage": "en",
  "strings": {
    "A command. Paste it into Terminal.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Befehl. Füge ihn im Terminal ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comando. Pégalo en Terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une commande. Collez-la dans Terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comando. Incollalo in Terminale."
          }
        }
      }
    },
    "A menu bar app that keeps the token in your Keychain and logs every call.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Menüleisten-App, die das Token in deinem Schlüsselbund aufbewahrt und jeden Aufruf protokolliert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app de la barra de menús que guarda el token en tu Llavero y registra cada llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une app de la barre des menus qui conserve le jeton dans votre Trousseau et journalise chaque appel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’app della barra dei menu che conserva il token nel tuo Portachiavi e registra ogni chiamata."
          }
        }
      }
    },
    "A table for ~/.codex/config.toml.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Tabelle für ~/.codex/config.toml."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tabla para ~/.codex/config.toml."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une table pour ~/.codex/config.toml."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tabella per ~/.codex/config.toml."
          }
        }
      }
    },
    "Add to Bastion…": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Bastion hinzufügen …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir a Bastion…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter à Bastion…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi a Bastion…"
          }
        }
      }
    },
    "Allow writes": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibzugriff erlauben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir cambios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l’écriture"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti modifiche"
          }
        }
      }
    },
    "An agent is using the MCP server": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Agent verwendet den MCP-Server"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente está usando el servidor MCP"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent utilise le serveur MCP"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente sta usando il server MCP"
          }
        }
      }
    },
    "An agent was turned away for its token": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Agent wurde wegen seines Tokens abgewiesen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rechazó a un agente por su token"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent a été refusé à cause de son jeton"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente è stato respinto per il suo token"
          }
        }
      }
    },
    "An agent was turned away for its token. Copy its configuration again.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Agent wurde wegen seines Tokens abgewiesen. Kopiere seine Konfiguration erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rechazó a un agente por su token. Vuelve a copiar su configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent a été refusé à cause de son jeton. Copiez de nouveau sa configuration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente è stato respinto per il suo token. Copia di nuovo la sua configurazione."
          }
        }
      }
    },
    "Bastion is a menu bar app that stands in front of your MCP servers: the tokens in your Keychain instead of in every client's config, every call logged, and writes behind a switch of its own.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bastion ist eine Menüleisten-App, die vor deinen MCP-Servern steht: die Tokens in deinem Schlüsselbund statt in der Konfiguration jedes Clients, jeder Aufruf protokolliert und Schreibzugriffe hinter einem eigenen Schalter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bastion es una app de la barra de menús que se sitúa delante de tus servidores MCP: los tokens en tu Llavero en lugar de en la configuración de cada cliente, cada llamada registrada y los cambios tras un interruptor propio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bastion est une app de la barre des menus placée devant vos serveurs MCP : les jetons dans votre Trousseau plutôt que dans la configuration de chaque client, chaque appel journalisé, et l’écriture soumise à son propre interrupteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bastion è un’app della barra dei menu che si pone davanti ai tuoi server MCP: i token nel tuo Portachiavi invece che nella configurazione di ogni client, ogni chiamata registrata e le modifiche dietro un proprio interruttore."
          }
        }
      }
    },
    "Copied": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert"
          }
        },
        "es": {
