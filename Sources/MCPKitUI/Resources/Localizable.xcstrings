          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia configurazione"
          }
        }
      }
    },
    "Copy the configuration for %@, with its token": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguration für %@ samt Token kopieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar la configuración para %@, con su token"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier la configuration pour %@, avec son jeton"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia la configurazione per %@, con il relativo token"
          }
        }
      }
    },
    "For the mcp.json that MCP: Open User Configuration opens.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die mcp.json, die der Befehl „MCP: Open User Configuration“ öffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para el archivo mcp.json que abre el comando “MCP: Open User Configuration”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour le fichier mcp.json qu’ouvre la commande « MCP: Open User Configuration »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per il file mcp.json che apre il comando “MCP: Open User Configuration”."
          }
        }
      }
    },
    "For ~/.cursor/mcp.json, beside any servers already there.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ~/.cursor/mcp.json, neben den Servern, die dort schon stehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ~/.cursor/mcp.json, junto a los servidores que ya haya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ~/.cursor/mcp.json, à côté des serveurs déjà présents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ~/.cursor/mcp.json, accanto ai server già presenti."
          }
        }
      }
    },
    "Get Bastion": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bastion laden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtener Bastion"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenir Bastion"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni Bastion"
          }
        }
      }
    },
    "Hands this server to Bastion, which asks before adding it. Bastion keeps the token in your Keychain, logs every call, and holds writes behind a switch of its own.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übergibt diesen Server an Bastion, das vor dem Hinzufügen nachfragt. Bastion bewahrt das Token in deinem Schlüsselbund auf, protokolliert jeden Aufruf und stellt Schreibzugriffe hinter einen eigenen Schalter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa este servidor a Bastion, que pregunta antes de añadirlo. Bastion guarda el token en tu Llavero, registra cada llamada y pone los cambios tras un interruptor propio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confie ce serveur à Bastion, qui demande confirmation avant de l’ajouter. Bastion conserve le jeton dans votre Trousseau, journalise chaque appel et soumet l’écriture à son propre interrupteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Affida questo server a Bastion, che chiede conferma prima di aggiungerlo. Bastion conserva il token nel tuo Portachiavi, registra ogni chiamata e mette le modifiche dietro un proprio interruttore."
          }
        }
      }
    },
    "Hide": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbergen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi"
          }
        }
      }
    },
    "Keeps the token in your Keychain and logs every call. It asks before adding the server.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahrt das Token in deinem Schlüsselbund auf und protokolliert jeden Aufruf. Fragt nach, bevor der Server hinzugefügt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el token en tu Llavero y registra cada llamada. Pregunta antes de añadir el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve le jeton dans votre Trousseau et journalise chaque appel. Demande confirmation avant d’ajouter le serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva il token nel tuo Portachiavi e registra ogni chiamata. Chiede conferma prima di aggiungere il server."
          }
        }
      }
    },
    "Last request from an agent: %@": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte Anfrage eines Agenten: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Última solicitud de un agente: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière requête d’un agent : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultima richiesta di un agente: %@"
          }
        }
      }
    },
    "Let an AI agent on this Mac reach your data": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einem KI-Agenten auf diesem Mac Zugriff auf deine Daten geben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que un agente de IA de este Mac acceda a tus datos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permettre à un agent IA sur ce Mac d’accéder à vos données"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a un agente IA su questo Mac di accedere ai tuoi dati"
          }
        }
      }
    },
    "Lets an AI agent on this Mac read %@'s data. It listens on 127.0.0.1 only: nothing is reachable from another machine, and nothing leaves this one.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt einem KI-Agenten auf diesem Mac, deine Daten in %@ zu lesen. Der Server ist nur unter 127.0.0.1 erreichbar: Kein anderer Rechner kommt an ihn heran, und nichts verlässt diesen Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que un agente de IA de este Mac lea tus datos en %@. Solo escucha en 127.0.0.1: nada es accesible desde otro equipo y nada sale de este."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à un agent IA sur ce Mac de lire vos données dans %@. Il écoute uniquement sur 127.0.0.1 : rien n’est accessible depuis une autre machine, et rien ne quitte celle-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente a un agente IA su questo Mac di leggere i tuoi dati in %@. È in ascolto solo su 127.0.0.1: niente è raggiungibile da un altro computer e niente esce da questo."
          }
        }
      }
    },
    "Listening on 127.0.0.1:%@": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreichbar unter 127.0.0.1:%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchando en 127.0.0.1:%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’écoute sur 127.0.0.1:%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ascolto su 127.0.0.1:%@"
          }
        }
      }
    },
