    "Regenerating stops any agent still using the old token.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Neu erzeugen“ sperrt jeden Agenten aus, der noch das alte Token verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al regenerarlo, deja de funcionar cualquier agente que aún use el token anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Régénérer bloque tout agent qui utilise encore l’ancien jeton."
          }
        },
